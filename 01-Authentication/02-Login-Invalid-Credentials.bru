meta {
  name: 02 - User Login (Invalid Credentials)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "aquil",
    "password": "wrong_password_999"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Invalid username or password
}
