meta {
  name: 02 - User Login (Invalid Credentials)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "aquil",
    "password": "wrong_password_999"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Invalid username or password
}

script:pre-request {
  console.log("--> [AUTH NEGATIVE] Attempting login with invalid password...");
}

script:post-response {
  console.log("<-- [AUTH NEGATIVE] Response code:", res.getStatus());
}

tests {
  test("Verify HTTP status is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify error payload structure", function() {
    const data = res.getBody();
    expect(data).to.be.an('object');
    expect(data.error).to.equal('Invalid username or password');
    expect(data.token).to.be.undefined;
  });
}
