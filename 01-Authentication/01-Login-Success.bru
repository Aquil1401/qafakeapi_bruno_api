meta {
  name: 01 - User Login (Success & Capture Token)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "aquil",
    "password": "test1234"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.message: eq Login successful
  res.body.user.username: eq aquil
  res.body.user.role: eq admin
}

script:post-response {
  const data = res.getBody();
  if (data && data.token) {
    bru.setEnvVar("authToken", data.token);
    console.log("Captured JWT Bearer Token:", data.token);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response time is under 1500ms SLA", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Content-Type header is JSON", function() {
    expect(res.getHeader('content-type')).to.include('application/json');
  });

  test("Response body contains valid token and user structure", function() {
    const data = res.getBody();
    expect(data).to.be.an('object');
    expect(data.token).to.be.a('string').and.not.empty;
    expect(data.user).to.be.an('object');
    expect(data.user.id).to.equal(1);
    expect(data.user.username).to.equal('aquil');
    expect(data.user.role).to.equal('admin');
  });
}

