meta {
  name: 06 - Update Existing Product
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/products/{{createdProductId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
  Content-Type: application/json
}

body:json {
  {
    "price": 1999,
    "stock": 45
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.price: eq 1999
  res.body.stock: eq 45
}

script:pre-request {
  const prodId = bru.getEnvVar("createdProductId");
  console.log("--> [PRODUCTS CRUD] Updating product ID:", prodId);
}

script:post-response {
  console.log("<-- [PRODUCTS CRUD] Successfully updated product price & stock.");
}

tests {
  test("Verify HTTP status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify updated product values", function() {
    const data = res.getBody();
    expect(data).to.be.an('object');
    expect(data.price).to.equal(1999);
    expect(data.stock).to.equal(45);
  });
}
