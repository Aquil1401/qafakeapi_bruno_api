meta {
  name: 03 - Filter Products by Category
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/products?category=electronics
  body: none
  auth: none
}

params:query {
  category: electronics
}

assert {
  res.status: eq 200
  res.body.products: isDefined
  res.body.products.length: gte 1
  res.body.products[0].category: eq electronics
}

script:pre-request {
  console.log("--> [PRODUCTS FILTER] Filtering products by category: 'electronics'...");
}

tests {
  test("Verify HTTP status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify filtered items strictly belong to queried category", function() {
    const products = res.getBody().products;
    expect(products).to.be.an('array').that.is.not.empty;
    products.forEach(p => {
      expect(p.category.toLowerCase()).to.equal('electronics');
    });
  });
}
