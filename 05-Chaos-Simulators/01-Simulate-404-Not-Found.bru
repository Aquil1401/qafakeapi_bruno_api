meta {
  name: 01 - Simulate 404 Not Found
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/mock/status/404
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.statusCode: eq 404
  res.body.simulated: eq true
  res.body.message: contains Not Found
}

script:pre-request {
  console.log("--> [CHAOS] Simulating 404 Not Found error...");
}

tests {
  test("Verify HTTP status is 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify chaos simulator payload contract", function() {
    const data = res.getBody();
    expect(data.statusCode).to.equal(404);
    expect(data.simulated).to.be.true;
    expect(data.message).to.include('Not Found');
    expect(data.timestamp).to.be.a('string');
  });
}
