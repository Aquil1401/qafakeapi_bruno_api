meta {
  name: 03 - Simulate 429 Rate Limit
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/mock/status/429
  body: none
  auth: none
}

assert {
  res.status: eq 429
  res.body.statusCode: eq 429
  res.body.simulated: eq true
  res.body.message: contains Rate limit exceeded
}

script:pre-request {
  console.log("--> [CHAOS] Simulating 429 Rate Limiting...");
}

tests {
  test("Verify HTTP status is 429 Too Many Requests", function() {
    expect(res.getStatus()).to.equal(429);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify 429 rate limit response structure", function() {
    const data = res.getBody();
    expect(data.statusCode).to.equal(429);
    expect(data.simulated).to.be.true;
    expect(data.message).to.include('Rate limit exceeded');
  });
}
