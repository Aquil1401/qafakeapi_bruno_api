meta {
  name: 02 - Find Order by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/101
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq 101
  res.body.userId: eq 1
  res.body.status: eq delivered
  res.body.items.length: gte 1
  res.body.totalAmount: gt 0
}

script:pre-request {
  console.log("--> [ORDERS] Fetching single order breakdown for ID: 101...");
}

tests {
  test("Verify HTTP status is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Verify response time is within SLA (< 1500ms)", function() {
    expect(res.getResponseTime()).to.be.below(1500);
  });

  test("Verify order 101 payload structure and values", function() {
    const order = res.getBody();
    expect(order).to.be.an('object');
    expect(order.id).to.equal(101);
    expect(order.userId).to.equal(1);
    expect(order.status).to.equal('delivered');
    expect(order.items).to.be.an('array').with.lengthOf.at.least(1);
    expect(order.totalAmount).to.be.a('number').above(0);
  });
}
